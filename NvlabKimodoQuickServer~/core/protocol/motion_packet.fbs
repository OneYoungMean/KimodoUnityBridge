table CameraTrack {
  fps:float;
  num_frames:uint;
  positions:[float];
  rotations:[float];
  fov_y:[float];
  lens_shift:[float];
}

table MotionPacket {
  version:uint = 1;
  fps:float;
  num_frames:uint;
  num_joints:uint;
  joint_names:[string];
  joint_parents:[int];
  root_positions:[float];
  local_rot_quats:[float];
  model_name:string;
  foot_contacts:[ubyte];
  camera_track:CameraTrack;
  global_time_seconds:[float];
  human_detection:[ubyte];
}

root_type MotionPacket;
file_identifier "KMB1";
