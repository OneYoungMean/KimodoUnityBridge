{
  "tools": [
    {
      "name": "kimodo_help",
      "description": "Return the command manual, detailed parameter documentation for one command, or currently viable model configurations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command name whose full manual entry should be returned."
          },
          "section": {
            "type": "string",
            "enum": [
              "commands",
              "models",
              "constraints"
            ],
            "default": "commands"
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Inspect generation parameters and examples.",
          "arguments": {
            "command": "kimodo_generate_animation"
          }
        }
      ]
    },
    {
      "name": "kimodo_install_server",
      "description": "Start an asynchronous project-local QuickServer installation task. Returns a request_id (install:<guid>) that can be polled with kimodo_get_generation; models and the Python environment are preserved.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Install the local server, then poll the returned request_id.",
          "arguments": {}
        }
      ]
    },
    {
      "name": "session_get_or_create",
      "description": "Create the current animation Session and its dedicated visible Session GameObject, or reopen an existing named Session. Optionally add the current active-scene Animator character at creation; use character=@active_animator to bind the selected/open Animator instead of a saved prefab path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Stable Session name. An existing name selects that Session; omit it to return the current Session or create one when none exists."
          },
          "character": {
            "type": "string",
            "description": "Optional scene character name or hierarchy path; use @active_animator to use the currently selected/open Animator character."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Create a named Session from the selected scene Animator.",
          "arguments": {
            "name": "MotionAuthoring",
            "character": "@active_animator"
          }
        }
      ]
    },
    {
      "name": "session_get_raw",
      "description": "Resolve a named Session character, track, clip, or constraint to portable Unity object metadata for external API or tool interop; the result includes guid, asset_guid, path, object_type, and optional character.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "track",
              "clip",
              "constraint"
            ]
          },
          "name": {
            "type": "string",
            "description": "Exact Session object name."
          },
          "character": {
            "type": "string",
            "description": "Optional character name to disambiguate clips, tracks, or constraints."
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Resolve a returned Clip name to its Unity asset metadata.",
          "arguments": {
            "kind": "clip",
            "name": "<clip>",
            "character": "<character>"
          }
        }
      ]
    },
    {
      "name": "session_close",
      "description": "Close the selected animation editing Session while preserving its Timeline, assets, and AI-readable Session JSON.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session id; omitted uses the current Session."
          },
          "keepObject": {
            "type": "boolean",
            "description": "Defaults to true. Keep the disabled Session GameObject and Director; false destroys the Session GameObject while preserving saved assets."
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Close the current Session and keep its disabled scene object.",
          "arguments": {
            "keepObject": true
          }
        }
      ]
    },
    {
      "name": "session_add",
      "description": "Add scene or project content to the current Session. kind=character adds one scene Humanoid Animator or renderable Mesh object (use character=@active_animator for the selected/open Animator); kind=clip appends one project AnimationClip to a Session character; kind=animator imports same-Layer State-to-State transitions as Timeline-composed transition_clip records without baking transition assets. Returns safe names to reuse. Appended clips keep a fixed 4-frame safezone.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "clip",
              "animator"
            ]
          },
          "character": {
            "type": "string",
            "description": "Scene character name/path for kind=character, or @active_animator for the currently selected/open Animator; target Session character name otherwise."
          },
          "clip": {
            "type": "string",
            "description": "Project AnimationClip name for kind=clip."
          },
          "animator": {
            "type": "string",
            "description": "Scene Animator name/path for kind=animator."
          },
          "ignore_warning": {
            "type": "boolean",
            "description": "Import all transition variants when the projected transition count exceeds 128; defaults to false."
          }
        },
        "required": [
          "kind",
          "character"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Add the selected scene Animator and retain the returned character name.",
          "arguments": {
            "kind": "character",
            "character": "@active_animator"
          }
        },
        {
          "description": "Append a project AnimationClip to the returned Session character.",
          "arguments": {
            "kind": "clip",
            "character": "<character>",
            "clip": "<project AnimationClip name>"
          }
        },
        {
          "description": "Import an Animator controller's transitions.",
          "arguments": {
            "kind": "animator",
            "character": "<character>",
            "animator": "<scene Animator path>"
          }
        }
      ]
    },
    {
      "name": "animation_analyze",
      "description": "Analyze one immutable Session clip and render unified graph-space picture evidence. Select standard tile types explicitly and choose composite, individual tiles, or both outputs. Results include root_trajectory, endpoint_pose_comparison, motion_profile, foot_contacts, phase_track, and evidence paths. Completed Clips are never modified.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "clips": {
            "type": "array",
            "description": "Exactly one immutable Session clip reference. Comparison callers analyze each candidate separately.",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "source",
                    "target"
                  ]
                },
                "character": {
                  "type": "string"
                },
                "clip": {
                  "type": "string"
                }
              },
              "required": [
                "character",
                "clip"
              ]
            }
          },
          "picture": {
            "type": "object",
            "description": "Unified graph-space picture request with tiles and output mode."
          },
          "resolution": {
            "type": "integer",
            "minimum": 64,
            "maximum": 4096,
            "description": "Final picture tile resolution in pixels; accepts 64 through 4096. Rendering uses a 2x supersample and downsamples to this size. Defaults to 1920."
          }
        },
        "required": [
          "clips"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Analyze one returned Clip; open the returned image to inspect it.",
          "arguments": {
            "clips": [
              {
                "character": "<character>",
                "clip": "<clip>"
              }
            ],
            "picture": {
              "output": "composite"
            },
            "resolution": 512
          }
        }
      ]
    },
    {
      "name": "kimodo_record_range",
      "description": "Record a Session time range into an AnimationClip and append it to the source character.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start_frame": {
            "type": "integer",
            "description": "Inclusive Session frame at 60 FPS."
          },
          "end_frame": {
            "type": "integer",
            "description": "Exclusive Session frame at 60 FPS."
          },
          "character": {
            "type": "string",
            "description": "Safe source character name in the current Session."
          },
          "remove_root_motion": {
            "type": "boolean",
            "description": "Keep vertical motion but remove horizontal root translation and yaw; defaults to false."
          },
          "speed": {
            "type": "number",
            "description": "Playback speed multiplier; defaults to 1.0."
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "humanoid_muscle",
                  "character_bone",
                  "model_bone"
                ]
              },
              "folder": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "description": "Optional animation output settings."
          }
        },
        "required": [
          "start_frame",
          "end_frame",
          "character"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Record two seconds of the current Session at 60 FPS.",
          "arguments": {
            "character": "<character>",
            "start_frame": 0,
            "end_frame": 120,
            "output": {
              "name": "RecordedMotion"
            }
          }
        }
      ]
    },
    {
      "name": "kimodo_retarget_animation",
      "description": "Retarget one loaded animation to another current Session character and append the result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source_character": {
            "type": "string",
            "description": "Safe source character name in the selected Session."
          },
          "animation": {
            "type": "string",
            "description": "Safe source animation name."
          },
          "target_character": {
            "type": "string",
            "description": "Safe target character name in the selected Session."
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "humanoid_muscle",
                  "character_bone",
                  "model_bone"
                ]
              },
              "folder": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "description": "Optional animation output settings."
          }
        },
        "required": [
          "source_character",
          "animation",
          "target_character"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Retarget a loaded Clip to another Session character.",
          "arguments": {
            "source_character": "<source character>",
            "animation": "<clip>",
            "target_character": "<target character>",
            "output": {
              "name": "RetargetedMotion"
            }
          }
        }
      ]
    },
    {
      "name": "kimodo_generate_animation",
      "description": "Start asynchronous generation for a character in the current Session. The accepted request is recorded in session.json and must be polled by request_id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "character": {
            "type": "string",
            "description": "Safe character name in the current Session."
          },
          "prompt": {
            "type": "string",
            "description": "Motion prompt."
          },
          "duration_frames": {
            "type": "integer",
            "description": "Duration in 60 FPS Session frames; defaults to 300."
          },
          "loop": {
            "description": "Enable loop preprocessing, or provide per-axis endpoint locks with {enabled, lock_pos:{x,y,z}, lock_rot:{x,y,z}}.",
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean",
                    "description": "Enable bounded loop preprocessing; defaults to true when the loop object is supplied."
                  },
                  "lock_pos": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "boolean"
                      },
                      "y": {
                        "type": "boolean"
                      },
                      "z": {
                        "type": "boolean"
                      }
                    }
                  },
                  "lock_rot": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "x": {
                        "type": "boolean"
                      },
                      "y": {
                        "type": "boolean"
                      },
                      "z": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            ]
          },
          "path": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start_angle": {
                "type": "number"
              },
              "end_angle": {
                "type": "number"
              },
              "distance": {
                "type": "number",
                "minimum": 0
              },
              "heading": {
                "type": "number"
              }
            },
            "description": "Optional Root2D path override. Any angle enables path override; distance replaces the measured path length; heading is applied after path composition."
          },
          "generation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "model": {
                "type": "string"
              },
              "text_encoder": {
                "type": "string",
                "enum": [
                  "high_performance",
                  "high_precision"
                ]
              },
              "seed": {
                "type": "integer"
              },
              "diffusion_steps": {
                "type": "integer"
              }
            },
            "description": "Optional model and deterministic generation settings."
          },
          "output": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "humanoid_muscle",
                  "character_bone",
                  "model_bone"
                ]
              },
              "folder": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "description": "Optional animation output settings."
          },
          "analysis_option": {
            "type": "object",
            "description": "Optional analysis object for the phase-track analyzer. Legacy uniform keyframe-count controls are removed; Humanoid output always uses phase_track_version and continuous phase_track intervals."
          },
          "constraints": {
            "type": "array",
            "description": "Point, root_path, and inout boundary constraints. In/Out sources are explicit Clips sampled in C#; command frames use 60 FPS.",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "frame": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Relative frame in the generated clip at 60 FPS."
                    },
                    "fullbody": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "root2d": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        },
                        "position": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "heading": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "anyOf": [
                        {
                          "required": [
                            "pose"
                          ]
                        },
                        {
                          "required": [
                            "position",
                            "heading"
                          ]
                        }
                      ]
                    },
                    "left_hand": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "right_hand": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "left_foot": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "right_foot": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    }
                  },
                  "required": [
                    "frame"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "fullbody"
                      ]
                    },
                    {
                      "required": [
                        "root2d"
                      ]
                    },
                    {
                      "required": [
                        "left_hand"
                      ]
                    },
                    {
                      "required": [
                        "right_hand"
                      ]
                    },
                    {
                      "required": [
                        "left_foot"
                      ]
                    },
                    {
                      "required": [
                        "right_foot"
                      ]
                    }
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "frame": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0,
                      "description": "First path frame; defaults to the clip start."
                    },
                    "root_path": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "object",
                          "description": "Analyzed Root Path slot returned by animation_analyze at clips[].root_trajectory.path.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "path"
                      ]
                    }
                  },
                  "required": [
                    "root_path"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "inout": {
                      "type": "object",
                      "properties": {
                        "mode": {
                          "type": "string",
                          "enum": [
                            "outside",
                            "inside"
                          ],
                          "default": "outside",
                          "description": "Outside pads generation with source context then crops it off; inside constrains the returned clip's start/end windows. Output duration is preserved."
                        },
                        "in": {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "object",
                              "properties": {
                                "clip": {
                                  "type": "string",
                                  "description": "Safe completed source Clip name in the current Session."
                                },
                                "character": {
                                  "type": "string",
                                  "description": "Defaults to the generation character; cross-character sources are not supported."
                                },
                                "frame": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": "Optional boundary frame at 60 FPS, local to the Clip's played Timeline range. Defaults: outside In=last model frame / Out=first; inside In=first / Out=last."
                                }
                              },
                              "required": [
                                "clip"
                              ],
                              "additionalProperties": false
                            },
                            "window_frames": {
                              "type": "integer",
                              "minimum": 1,
                              "default": 1,
                              "description": "Coverage at 60 FPS. Converted to model frames by ceil(window_frames * model_fps / 60), minimum 1; never silently shortened."
                            },
                            "sample_count": {
                              "type": "integer",
                              "minimum": 1,
                              "default": 1,
                              "description": "Distinct samples within the converted window. One preserves the seam; multiple samples include both endpoints."
                            }
                          },
                          "required": [
                            "source"
                          ],
                          "additionalProperties": false
                        },
                        "out": {
                          "type": "object",
                          "properties": {
                            "source": {
                              "type": "object",
                              "properties": {
                                "clip": {
                                  "type": "string",
                                  "description": "Safe completed source Clip name in the current Session."
                                },
                                "character": {
                                  "type": "string",
                                  "description": "Defaults to the generation character; cross-character sources are not supported."
                                },
                                "frame": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "description": "Optional boundary frame at 60 FPS, local to the Clip's played Timeline range. Defaults: outside In=last model frame / Out=first; inside In=first / Out=last."
                                }
                              },
                              "required": [
                                "clip"
                              ],
                              "additionalProperties": false
                            },
                            "window_frames": {
                              "type": "integer",
                              "minimum": 1,
                              "default": 1,
                              "description": "Coverage at 60 FPS. Converted to model frames by ceil(window_frames * model_fps / 60), minimum 1; never silently shortened."
                            },
                            "sample_count": {
                              "type": "integer",
                              "minimum": 1,
                              "default": 1,
                              "description": "Distinct samples within the converted window. One preserves the seam; multiple samples include both endpoints."
                            }
                          },
                          "required": [
                            "source"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "required": [],
                      "additionalProperties": false,
                      "anyOf": [
                        {
                          "required": [
                            "in"
                          ]
                        },
                        {
                          "required": [
                            "out"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "inout"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          }
        },
        "required": [
          "character",
          "prompt"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "description": "Generate two seconds and poll the returned request_id.",
          "arguments": {
            "character": "<character>",
            "prompt": "Stand still and breathe naturally",
            "duration_frames": 120
          }
        },
        {
          "description": "Continue a source Clip using its final half-second sampled five times. Names must come from the current Session; the result contains inout_sampling diagnostics.",
          "arguments": {
            "character": "<character>",
            "prompt": "Stop walking and stand upright",
            "duration_frames": 120,
            "loop": false,
            "constraints": [
              {
                "inout": {
                  "mode": "outside",
                  "in": {
                    "source": {
                      "clip": "<source clip>"
                    },
