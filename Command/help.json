{
  "tools": [
    {
      "name": "kimodo_help",
      "description": "Return the command manual, detailed parameter documentation for one command, or currently viable model configurations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command name whose full manual entry should be returned."
          },
          "section": {
            "type": "string",
            "enum": [
              "commands",
              "models",
              "constraints"
            ],
            "default": "commands"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_install_server",
      "description": "Initialize the project-local QuickServer runtime on first use, or refresh it when installation, upgrade, or recovery is required. This preserves models and the Python environment, then restarts the server.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "session_get_or_create",
      "description": "Create the current animation Session and its dedicated Preview Scene, or reopen an existing named Session. Optionally copy a scene character into the Preview Scene at creation.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Stable Session name. An existing name selects that Session; omit it to return the current Session or create one when none exists."
          },
          "character": {
            "type": "string",
            "description": "Optional scene character name or hierarchy path to copy into the Preview Scene."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "session_get_raw",
      "description": "Resolve a named Session character, track, clip, or constraint to portable Unity object metadata for external API or tool interop; the result includes guid, asset_guid, path, object_type, and optional character.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["character", "track", "clip", "constraint"]
          },
          "name": {
            "type": "string",
            "description": "Exact Session object name."
          },
          "character": {
            "type": "string",
            "description": "Optional character name to disambiguate clips, tracks, or constraints."
          }
        },
        "required": ["kind", "name"],
        "additionalProperties": false
      }
    },
    {
      "name": "session_close",
      "description": "Close the selected animation editing Session while preserving its Timeline, assets, and AI-readable Session JSON.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session id; omitted uses the current Session."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "session_add",
      "description": "Add scene or project content to the current Session. kind=character adds one scene Humanoid Animator or renderable Mesh object; kind=clip appends one project AnimationClip to a Session character; kind=animator imports same-Layer State-to-State transitions as Timeline-composed transition_clip records without baking transition assets. Returns safe names to reuse. Appended clips keep a fixed 4-frame safezone.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session id; omitted uses the current Session."
          },
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "clip",
              "animator"
            ]
          },
          "character": {
            "type": "string",
            "description": "Scene character name/path for kind=character, or target Session character name otherwise."
          },
          "clip": {
            "type": "string",
            "description": "Project AnimationClip name for kind=clip."
          },
          "animator": {
            "type": "string",
            "description": "Scene Animator name/path for kind=animator."
          },
          "ignore_warning": {
            "type": "boolean",
            "description": "Import all transition variants when the projected transition count exceeds 128; defaults to false."
          }
        },
        "required": [
          "kind",
          "character"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "animation_analyze",
      "description": "Analyze one or two immutable Session clips and render visual evidence synchronously. Each Humanoid clips[] result includes root_trajectory.path plus clip-start-local Root XZ, heading, delta-Y samples, distance/speed/heading metrics, and source human scale; the path is stored on the Pose Cache Track for reuse. Mesh-only results omit Humanoid trajectory/contact data. Completed Clips are never modified.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session id; omitted uses the current Session."
          },
          "clips": {
            "type": "array",
            "description": "One or two immutable Session clip references. Every item explicitly names its Session character; role defaults to source for the first item and target for the second.",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "source",
                    "target"
                  ]
                },
                "character": {
                  "type": "string"
                },
                "clip": {
                  "type": "string"
                }
              },
              "required": [
                "character",
                "clip"
              ]
            }
          },
          "level": {
            "type": "string",
            "enum": [
              "low",
              "middle",
              "high"
            ],
            "default": "middle"
          },
          "resolution": {
            "type": "integer",
            "minimum": 64,
            "maximum": 4096,
            "description": "Final picture tile resolution in pixels; accepts 64 through 4096. Rendering uses a 2x supersample and downsamples to this size. Defaults to 512."
          }
        },
        "required": [
          "clips"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "animation_compare",
      "description": "Compare two animation ranges or transition-like clip ranges without modifying the Session.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session id; omitted uses the current Session."
          },
          "character": {
            "type": "string",
            "description": "Safe character name in the current Session."
          },
          "origin": {
            "type": "object",
            "description": "Origin animation and half-open frame range."
          },
          "target": {
            "type": "object",
            "description": "Target animation and half-open frame range."
          }
        },
        "required": [
          "character",
          "origin",
          "target"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_record_range",
      "description": "Record a Session time range into an AnimationClip and append it to the source character.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session id; omitted uses the current Session."
          },
          "start_frame": {
            "type": "integer",
            "description": "Inclusive Session frame at 60 FPS."
          },
          "end_frame": {
            "type": "integer",
            "description": "Exclusive Session frame at 60 FPS."
          },
          "character": {
            "type": "string",
            "description": "Safe source character name in the current Session."
          },
          "remove_root_motion": {
            "type": "boolean",
            "description": "Keep vertical motion but remove horizontal root translation and yaw; defaults to false."
          },
          "speed": {
            "type": "number",
            "description": "Playback speed multiplier; defaults to 1.0."
          },
          "name": {
            "type": "string",
            "description": "Requested safe output animation name."
          },
          "output_folder": {
            "type": "string",
            "description": "Unity folder under Assets; defaults to Assets/KimodoGeneratedClips."
          }
        },
        "required": [
          "start_frame",
          "end_frame",
          "character"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_retarget_animation",
      "description": "Retarget one loaded animation to another current Session character and append the result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Session id; omitted uses the current Session."
          },
          "source_character": {
            "type": "string",
            "description": "Safe source character name in the selected Session."
          },
          "animation": {
            "type": "string",
            "description": "Safe source animation name."
          },
          "target_character": {
            "type": "string",
            "description": "Safe target character name in the selected Session."
          },
          "name": {
            "type": "string",
            "description": "Requested safe output animation name."
          },
          "output_folder": {
            "type": "string",
            "description": "Unity folder under Assets; defaults to Assets/KimodoGeneratedClips."
          }
        },
        "required": [
          "source_character",
          "animation",
          "target_character"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_generate_animation",
      "description": "Start asynchronous generation for a character in the current Session. The accepted request is recorded in session.json and must be polled by request_id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "character": {
            "type": "string",
            "description": "Safe character name in the current Session."
          },
          "prompt": {
            "type": "string",
            "description": "Motion prompt."
          },
          "duration_frames": {
            "type": "integer",
            "description": "Duration in 60 FPS Session frames; defaults to 300."
          },
          "loop": {
            "type": "boolean",
            "description": "Enable bounded loop preprocessing; over-limit requests fall back to normal generation."
          },
          "model": {
            "type": "string",
            "description": "Registered model name/configuration id; omitted uses the Project Settings default. Use kimodo_help({section:'models'}) to query models."
          },
          "text_encoder_model": {
            "type": "string",
            "enum": [
              "high_performance",
              "high_precision"
            ],
            "default": "high_performance"
          },
          "seed": {
            "type": "integer",
            "description": "Deterministic seed; omitted chooses a random seed."
          },
          "diffusion_steps": {
            "type": "integer",
            "description": "Diffusion steps; omitted uses the model default."
          },
          "output_mode": {
            "type": "string",
            "enum": [
              "humanoid_muscle",
              "character_bone",
              "model_bone"
            ],
            "default": "humanoid_muscle"
          },
          "output_folder": {
            "type": "string",
            "description": "Unity folder under Assets; defaults to Assets/KimodoGeneratedClips."
          },
          "name": {
            "type": "string",
            "description": "Requested safe animation name; defaults to the prompt."
          },
          "analysis_option": {
            "type": "object",
            "description": "Optional analysis object; set keyframes.enabled=true to return screenshot keyframes."
          },
          "path_begin_angle_degrees": {
            "type": "number",
            "description": "Absolute Unity yaw for the Root2D path start; providing either path angle enables same-seed Path Override, and an omitted peer defaults to zero."
          },
          "path_end_angle_degrees": {
            "type": "number",
            "description": "Absolute Unity yaw for the Root2D path end; providing either path angle enables same-seed Path Override, and an omitted peer defaults to zero."
          },
          "override_heading_degrees": {
            "type": "number",
            "description": "Regenerate with the same seed and apply this absolute Unity yaw to Root2D constraints every 30 frames; positive turns right and zero faces Unity forward."
          },
          "constraints": {
            "type": "array",
            "description": "Point constraints and reusable root_path constraints for the generated clip.",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "frame": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Relative frame in the generated clip at 60 FPS."
                    },
                    "fullbody": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "root2d": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        },
                        "position": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "heading": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "anyOf": [
                        {
                          "required": [
                            "pose"
                          ]
                        },
                        {
                          "required": [
                            "position",
                            "heading"
                          ]
                        }
                      ]
                    },
                    "left_hand": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "right_hand": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "left_foot": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "right_foot": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    }
                  },
                  "required": [
                    "frame"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "fullbody"
                      ]
                    },
                    {
                      "required": [
                        "root2d"
                      ]
                    },
                    {
                      "required": [
                        "left_hand"
                      ]
                    },
                    {
                      "required": [
                        "right_hand"
                      ]
                    },
                    {
                      "required": [
                        "left_foot"
                      ]
                    },
                    {
                      "required": [
                        "right_foot"
                      ]
                    }
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "frame": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0,
                      "description": "First path frame; defaults to the clip start."
                    },
                    "root_path": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "object",
                          "description": "Analyzed Root Path slot returned by animation_analyze at clips[].root_trajectory.path.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "path"
                      ]
                    }
                  },
                  "required": [
                    "root_path"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "character",
          "prompt"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pose_get",
      "description": "Sample one current-Session clip frame into a new External Pose slot. Returns the only reusable pose identity: {track,index}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "character": {
                "type": "string"
              },
              "clip": {
                "type": "string"
              },
              "frame": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "character",
              "clip",
              "frame"
            ]
          },
          "full_data": {
            "type": "boolean",
            "description": "Return all 49 muscles and TQ channels; defaults to false."
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pose_contract",
      "description": "Align a target External Pose end-effector to an origin External Pose and create a new External Pose slot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "object",
            "description": "External Pose slot in the current Session.",
            "additionalProperties": false,
            "properties": {
              "track": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "track",
              "index"
            ]
          },
          "target": {
            "type": "object",
            "description": "External Pose slot in the current Session.",
            "additionalProperties": false,
            "properties": {
              "track": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "track",
              "index"
            ]
          },
          "endeffectors": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "left_hand",
                "right_hand",
                "left_foot",
                "right_foot"
              ]
            },
            "description": "End effectors to align."
          },
          "components": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "position",
                "rotation"
              ]
            },
            "description": "Components to align."
          },
          "mode": {
            "type": "string",
            "enum": [
              "align_target_root",
              "least_squares_root_fit"
            ]
          }
        },
        "required": [
          "origin",
          "target",
          "endeffectors",
          "components",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pose_set_root_transform",
      "description": "Modify the root transform of an External Pose slot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pose": {
            "type": "object",
            "description": "External Pose slot in the current Session.",
            "additionalProperties": false,
            "properties": {
              "track": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "track",
              "index"
            ]
          },
          "root": {
            "type": "object",
            "description": "Root position and rotation."
          }
        },
        "required": [
          "pose",
          "root"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pose_set_muscle",
      "description": "Modify one or more muscles of an External Pose slot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pose": {
            "type": "object",
            "description": "External Pose slot in the current Session.",
            "additionalProperties": false,
            "properties": {
              "track": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "track",
              "index"
            ]
          },
          "muscles": {
            "type": "object",
            "description": "Map of muscle channel names to values."
          }
        },
        "required": [
          "pose",
          "muscles"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_get_generation",
      "description": "Get generation progress, the generated animation safe name, and its project-relative clip asset path when completed; path is empty until a clip exists.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Request id returned by a generate tool."
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_cancel_generation",
      "description": "Cancel an active Kimodo generation request.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Request id returned by a generate tool."
          },
          "reason": {
            "type": "string",
            "description": "Optional cancellation reason."
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      }
    }
  ]
}
