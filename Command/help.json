{
  "tools": [
    {
      "name": "kimodo_help",
      "description": "Return the command manual, detailed parameter documentation for one command, or currently viable model configurations.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "description": "Command name whose full manual entry should be returned."
          },
          "section": {
            "type": "string",
            "enum": [
              "commands",
              "models",
              "constraints"
            ],
            "default": "commands"
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_install_server",
      "description": "Start an asynchronous project-local QuickServer installation task. Returns a request_id (install:<guid>) that can be polled with kimodo_get_generation; models and the Python environment are preserved.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "session_get_or_create",
      "description": "Create the current animation Session and its dedicated visible Session GameObject, or reopen an existing named Session. Optionally add the current active-scene Animator character at creation; use character=@active_animator to bind the selected/open Animator instead of a saved prefab path.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Stable Session name. An existing name selects that Session; omit it to return the current Session or create one when none exists."
          },
          "character": {
            "type": "string",
            "description": "Optional scene character name or hierarchy path; use @active_animator to use the currently selected/open Animator character."
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "session_get_raw",
      "description": "Resolve a named Session character, track, clip, or constraint to portable Unity object metadata for external API or tool interop; the result includes guid, asset_guid, path, object_type, and optional character.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["character", "track", "clip", "constraint"]
          },
          "name": {
            "type": "string",
            "description": "Exact Session object name."
          },
          "character": {
            "type": "string",
            "description": "Optional character name to disambiguate clips, tracks, or constraints."
          }
        },
        "required": ["kind", "name"],
        "additionalProperties": false
      }
    },
    {
      "name": "session_close",
      "description": "Close the selected animation editing Session while preserving its Timeline, assets, and AI-readable Session JSON.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Advanced: explicit Session id; omit to use the current Session.",
            "x-kimodo-advanced": true
          }
        },
        "required": [],
        "additionalProperties": false
      }
    },
    {
      "name": "session_add",
      "description": "Add scene or project content to the current Session. kind=character adds one scene Humanoid Animator or renderable Mesh object (use character=@active_animator for the selected/open Animator); kind=clip appends one project AnimationClip to a Session character; kind=animator imports same-Layer State-to-State transitions as Timeline-composed transition_clip records without baking transition assets. Returns safe names to reuse. Appended clips keep a fixed 4-frame safezone.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Advanced: explicit Session id; omit to use the current Session.",
            "x-kimodo-advanced": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "clip",
              "animator"
            ]
          },
          "character": {
            "type": "string",
            "description": "Scene character name/path for kind=character, or @active_animator for the currently selected/open Animator; target Session character name otherwise."
          },
          "clip": {
            "type": "string",
            "description": "Project AnimationClip name for kind=clip."
          },
          "animator": {
            "type": "string",
            "description": "Scene Animator name/path for kind=animator."
          },
          "ignore_warning": {
            "type": "boolean",
            "description": "Advanced: import all transition variants when the projected transition count exceeds 128; defaults to false.",
            "x-kimodo-advanced": true
          }
        },
        "required": [
          "kind",
          "character"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "animation_analyze",
      "description": "Analyze exactly one immutable Session clip and render the fixed 16:9 test picture evidence. Comparison callers analyze candidates separately. Select a single tile with picture.output=tile and picture.tile_index. Results include root_trajectory.path, endpoint_pose_comparison, motion_profile, foot contacts, and phase_track. Completed Clips are never modified.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Advanced: explicit Session id; omit to use the current Session.",
            "x-kimodo-advanced": true
          },
          "clips": {
            "type": "array",
            "description": "Exactly one immutable Session clip reference. Comparison callers analyze each candidate separately.",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "role": {
                  "type": "string",
                  "enum": [
                    "source",
                    "target"
                  ]
                },
                "character": {
                  "type": "string"
                },
                "clip": {
                  "type": "string"
                }
              },
              "required": [
                "character",
                "clip"
              ]
            }
          },
          "picture": {
            "type": "object",
            "additionalProperties": false,
            "description": "Advanced: unified graph-space picture request. Omit to render all standard tiles as one composite. Use output=tile with a 1-based tile_index to export one tile only; in that mode resolution is the output height and defaults to 720.",
            "x-kimodo-advanced": true,
            "properties": {
              "tiles": {
                "type": "array",
                "items": { "type": "string", "enum": ["3d_track", "height_time_track", "3d_ghost", "3d_ghost_track", "key_pose", "step_pose"] },
                "minItems": 1,
                "uniqueItems": true
              },
              "output": {
                "type": "string",
                "enum": ["composite", "tile"],
                "default": "composite"
              },
              "tile_index": {
                "type": "integer",
                "minimum": 1,
                "description": "Advanced: 1-based tile number; required only when output is tile."
              }
            }
          },
          "resolution": {
            "type": "integer",
            "minimum": 64,
            "maximum": 4096,
            "description": "Advanced: final picture tile resolution in pixels; accepts 64 through 4096. Defaults to 512.",
            "x-kimodo-advanced": true
          },
          "analysis_option": {
            "type": "object",
            "description": "Advanced backend analysis options; omit for the standard analyzer.",
            "x-kimodo-advanced": true
          }
        },
        "required": [
          "clips"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_record_range",
      "description": "Record a Session time range into an AnimationClip and append it to the source character.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Advanced: explicit Session id; omit to use the current Session.",
            "x-kimodo-advanced": true
          },
          "start_frame": {
            "type": "integer",
            "description": "Inclusive Session frame at 60 FPS."
          },
          "end_frame": {
            "type": "integer",
            "description": "Exclusive Session frame at 60 FPS."
          },
          "character": {
            "type": "string",
            "description": "Safe source character name in the current Session."
          },
          "remove_root_motion": {
            "type": "boolean",
            "description": "Advanced: keep vertical motion but remove horizontal root translation and yaw; defaults to false.",
            "x-kimodo-advanced": true
          },
          "speed": {
            "type": "number",
            "description": "Advanced: playback speed multiplier; defaults to 1.0.",
            "x-kimodo-advanced": true
          },
          "name": {
            "type": "string",
            "description": "Advanced: requested safe output animation name.",
            "x-kimodo-advanced": true
          },
          "output_folder": {
            "type": "string",
            "description": "Advanced: Unity folder under Assets; defaults to Assets/KimodoGeneratedClips.",
            "x-kimodo-advanced": true
          }
        },
        "required": [
          "start_frame",
          "end_frame",
          "character"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_retarget_animation",
      "description": "Retarget one loaded animation to another current Session character and append the result.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string",
            "description": "Advanced: explicit Session id; omit to use the current Session.",
            "x-kimodo-advanced": true
          },
          "source_character": {
            "type": "string",
            "description": "Safe source character name in the selected Session."
          },
          "animation": {
            "type": "string",
            "description": "Safe source animation name."
          },
          "target_character": {
            "type": "string",
            "description": "Safe target character name in the selected Session."
          },
          "name": {
            "type": "string",
            "description": "Advanced: requested safe output animation name.",
            "x-kimodo-advanced": true
          },
          "output_folder": {
            "type": "string",
            "description": "Advanced: Unity folder under Assets; defaults to Assets/KimodoGeneratedClips.",
            "x-kimodo-advanced": true
          }
        },
        "required": [
          "source_character",
          "animation",
          "target_character"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_generate_animation",
      "description": "Start asynchronous generation for a character in the current Session. Core input is character and prompt; advanced model, sampling, output, path, and constraint overrides are optional. The accepted request is recorded in session.json and must be polled by request_id.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "character": {
            "type": "string",
            "description": "Safe character name in the current Session."
          },
          "prompt": {
            "type": "string",
            "description": "Motion prompt."
          },
          "duration_frames": {
            "type": "integer",
            "description": "Advanced: duration in 60 FPS Session frames; defaults to 300.",
            "x-kimodo-advanced": true
          },
          "loop": {
            "type": "boolean",
            "description": "Enable bounded loop preprocessing; over-limit requests fall back to normal generation."
          },
          "model": {
            "type": "string",
            "description": "Advanced: registered model name/configuration id; omit to use Project Settings default.",
            "x-kimodo-advanced": true
          },
          "text_encoder_model": {
            "type": "string",
            "enum": [
              "high_performance",
              "high_precision"
            ],
            "default": "high_performance",
            "x-kimodo-advanced": true
          },
          "seed": {
            "type": "integer",
            "description": "Advanced: deterministic seed; omitted chooses a random seed.",
            "x-kimodo-advanced": true
          },
          "diffusion_steps": {
            "type": "integer",
            "description": "Advanced: diffusion steps; omitted uses the model default.",
            "x-kimodo-advanced": true
          },
          "output_mode": {
            "type": "string",
            "enum": [
              "humanoid_muscle",
              "character_bone",
              "model_bone"
            ],
            "default": "humanoid_muscle",
            "x-kimodo-advanced": true
          },
          "output_folder": {
            "type": "string",
            "description": "Advanced: Unity folder under Assets; defaults to Assets/KimodoGeneratedClips.",
            "x-kimodo-advanced": true
          },
          "name": {
            "type": "string",
            "description": "Advanced: requested safe animation name; defaults to the prompt.",
            "x-kimodo-advanced": true
          },
          "analysis_option": {
            "type": "object",
            "description": "Advanced backend analysis options; omit for the standard phase-track analyzer.",
            "x-kimodo-advanced": true
          },
          "path_begin_angle_degrees": {
            "type": "number",
            "description": "Advanced: absolute Unity yaw for the Root2D path start.",
            "x-kimodo-advanced": true
          },
          "path_end_angle_degrees": {
            "type": "number",
            "description": "Advanced: absolute Unity yaw for the Root2D path end.",
            "x-kimodo-advanced": true
          },
          "override_heading_degrees": {
            "type": "number",
            "description": "Advanced: fixed absolute Unity yaw for Root2D constraints.",
            "x-kimodo-advanced": true
          },
          "constraints": {
            "type": "array",
            "description": "Advanced point constraints and reusable root_path constraints.",
            "x-kimodo-advanced": true,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "frame": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Relative frame in the generated clip at 60 FPS."
                    },
                    "fullbody": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "root2d": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        },
                        "position": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "heading": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      },
                      "anyOf": [
                        {
                          "required": [
                            "pose"
                          ]
                        },
                        {
                          "required": [
                            "position",
                            "heading"
                          ]
                        }
                      ]
                    },
                    "left_hand": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "right_hand": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "left_foot": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    },
                    "right_foot": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "pose": {
                          "type": "object",
                          "description": "External Pose slot in the current Session.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "pose"
                      ]
                    }
                  },
                  "required": [
                    "frame"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "fullbody"
                      ]
                    },
                    {
                      "required": [
                        "root2d"
                      ]
                    },
                    {
                      "required": [
                        "left_hand"
                      ]
                    },
                    {
                      "required": [
                        "right_hand"
                      ]
                    },
                    {
                      "required": [
                        "left_foot"
                      ]
                    },
                    {
                      "required": [
                        "right_foot"
                      ]
                    }
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "frame": {
                      "type": "integer",
                      "minimum": 0,
                      "default": 0,
                      "description": "First path frame; defaults to the clip start."
                    },
                    "root_path": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "object",
                          "description": "Analyzed Root Path slot returned by animation_analyze at clips[].root_trajectory.path.",
                          "additionalProperties": false,
                          "properties": {
                            "track": {
                              "type": "string"
                            },
                            "index": {
                              "type": "integer",
                              "minimum": 0
                            }
                          },
                          "required": [
                            "track",
                            "index"
                          ]
                        }
                      },
                      "required": [
                        "path"
                      ]
                    }
                  },
                  "required": [
                    "root_path"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "character",
          "prompt"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pose_get",
      "description": "Sample one current-Session clip frame into a new External Pose slot. Returns the only reusable pose identity: {track,index}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "character": {
                "type": "string"
              },
              "clip": {
                "type": "string"
              },
              "frame": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "character",
              "clip",
              "frame"
            ]
          },
          "full_data": {
            "type": "boolean",
            "description": "Advanced: return all 49 muscles and TQ channels; defaults to false.",
            "x-kimodo-advanced": true
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pose_set_root_transform",
      "description": "Modify the root transform of an External Pose slot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pose": {
            "type": "object",
            "description": "External Pose slot in the current Session.",
            "additionalProperties": false,
            "properties": {
              "track": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "track",
              "index"
            ]
          },
          "root": {
            "type": "object",
            "description": "Root position and rotation."
          }
        },
        "required": [
          "pose",
          "root"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "pose_set_muscle",
      "description": "Modify one or more muscles of an External Pose slot.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "pose": {
            "type": "object",
            "description": "External Pose slot in the current Session.",
            "additionalProperties": false,
            "properties": {
              "track": {
                "type": "string"
              },
              "index": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "track",
              "index"
            ]
          },
          "muscles": {
            "type": "object",
            "description": "Map of muscle channel names to values."
          }
        },
        "required": [
          "pose",
          "muscles"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_get_generation",
      "description": "Get status, progress, remaining seconds, and message for an install or generation request. Generated animation metadata and its project-relative asset path are included only after a generation completes.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Request id returned by kimodo_install_server or kimodo_generate_animation."
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "kimodo_cancel_generation",
      "description": "Cancel an active animation generation request. Installation requests cannot be canceled.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "request_id": {
            "type": "string",
            "description": "Generation request id returned by kimodo_generate_animation."
          },
          "reason": {
            "type": "string",
            "description": "Optional cancellation reason."
          }
        },
        "required": [
          "request_id"
        ],
        "additionalProperties": false
      }
    }
  ]
}
