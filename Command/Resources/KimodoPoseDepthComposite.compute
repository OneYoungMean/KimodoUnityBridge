#pragma kernel CompositePose
#pragma kernel BlendLayer
#pragma kernel InitDepth

Texture2D<float4> _PoseColor;
Texture2D<float4> _PoseDepth;
Texture2D<float4> _LayerColor;
Texture2D<float4> _BaseColor;
RWTexture2D<float4> _AccumColor;
RWTexture2D<float> _AccumDepth;
int _Width;
int _Height;
float _PoseAlpha;
int _ReversedZ;

[numthreads(8, 8, 1)]
void InitDepth(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    _AccumDepth[int2(id.xy)] = (_ReversedZ != 0) ? 0.0 : 1.0;
}

[numthreads(8, 8, 1)]
void CompositePose(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 p = int2(id.xy);
    float4 source = _PoseColor.Load(int3(p, 0));
    if (source.a <= 0.001) return;
    float depth = _PoseDepth.Load(int3(p, 0)).r;
    float nearest = _AccumDepth[p];
    bool nearer = (_ReversedZ != 0) ? depth > nearest : depth < nearest;
    if (!nearer) return;
    float alpha = saturate(_PoseAlpha * source.a);
    float4 destination = _BaseColor.Load(int3(p, 0));
    destination.rgb = lerp(destination.rgb, source.rgb, alpha);
    destination.a = alpha + destination.a * (1.0 - alpha);
    _AccumColor[p] = destination;
    _AccumDepth[p] = depth;
}

[numthreads(8, 8, 1)]
void BlendLayer(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;
    int2 p = int2(id.xy);
    float4 source = _LayerColor.Load(int3(p, 0));
    if (source.a <= 0.001) return;
    float alpha = saturate(source.a);
    float4 destination = _AccumColor[p];
    destination.rgb = lerp(destination.rgb, source.rgb, alpha);
    destination.a = max(destination.a, alpha + destination.a * (1.0 - alpha));
    _AccumColor[p] = destination;
}
